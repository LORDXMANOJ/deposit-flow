# Demo mode only needs a session secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Demo role picker: anyone can sign in as any demo role. Set to off outside a demo.
DEMO_ROLE_PICKER=on
# Automatic alert checks (in-process scheduler). Interval in minutes; set SCHEDULER=off to disable.
SCHEDULER=on
# For hosted cron (e.g. Vercel Cron) calling /api/cron/run-checks with 'Authorization: Bearer <CRON_SECRET>'
CRON_SECRET=replace-with-another-long-random-string
# Where the local demo database and uploaded files live (default ./.data)
DEPOSITFLOW_DATA_DIR=./.data
# Supabase deployment (see README "Supabase deployment"; not wired into the app code in this prototype)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server only, never expose to the browser
